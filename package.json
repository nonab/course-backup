{
  "name": "course-backup",
  "version": "1.1.0",
  "description": "Content Portability & Course Migration Tool for Creators & Educators",
  "main": "src/desktop/main.js",
  "bin": {
    "course-backup": "src/cli/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli/cli.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "lms",
    "course-migration",
    "data-portability",
    "learndash",
    "teachable",
    "kajabi",
    "skool",
    "tutor-lms",
    "sensei-lms",
    "electron",
    "puppeteer"
  ],
  "author": "nonab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonab/course-backup.git"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "content-disposition": "^1.0.1",
    "he": "^1.2.0",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coursebackup.app",
    "productName": "Course Backup",
    "artifactName": "Course-Backup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    }
  }
}